# ============================================================
# TravelPlan Orchestrator — 环境变量配置
# ============================================================
# 使用方法:
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 填入你的 API key
#   3. .env 已在 .gitignore 中，不会被提交
# ============================================================

# === DeepSeek API (LLM — 行程生成核心) ===
# 注册: https://platform.deepseek.com/
# 获取: Dashboard → API Keys → Create Key
# 文档: https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 模型可选: deepseek-v4-flash, deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash

# === 高德地图 API (地理编码 + 路线 + 交通时间) ===
# 注册: https://lbs.amap.com/
# 获取: 控制台 → 应用管理 → 创建应用 → 添加 Key (选择「Web服务」)
# 免费层: 5,000 次/天
# 文档: https://lbs.amap.com/api/webservice/summary/
AMAP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === 途牛 MCP 开放平台 (酒店/机票/门票) ===
# 注册: https://openapi.tuniu.cn/
# 获取: 创建应用 → 获取 API Key
# 协议: JSON-RPC 2.0 over HTTP
# 文档: https://openapi.tuniu.cn/docs
TUNIU_API_KEY=sk-xxxxxxxxxxxxxxxx

# === M3 endpoint snapshot (可选；默认使用官方只读端点) ===
# AMAP_GEOCODE_URL=https://restapi.amap.com/v3/geocode/geo
# TUNIU_HOTEL_URL=https://openapi.tuniu.cn/mcp/hotel
# TUNIU_FLIGHT_URL=https://openapi.tuniu.cn/mcp/flight
# TUNIU_TICKET_URL=https://openapi.tuniu.cn/mcp/ticket

# === M3 Live Tool 空结果合同（可选；需替换为供应商确认无结果的查询） ===
# 默认使用不含真实行政区词的唯一虚构地址，避免高德模糊回退到真实街道。
# AMAP_LIVE_EMPTY_TEXT=M3NORESULTX9Q7V5K3J1
# AMAP_LIVE_EMPTY_REGION=北京
# TUNIU_LIVE_EMPTY_DESTINATION=__M3_NO_MATCH_DESTINATION__

# === 超时与重试 (可选，有默认值) ===
# LLM_TIMEOUT_SECONDS=60
# API_TIMEOUT=15
# API_MAX_RETRIES=3

# === Local observability output: CLI stdout; JSONL logs stderr ===
LOG_LEVEL=INFO
CONSOLE_SPAN_EXPORTER=false
